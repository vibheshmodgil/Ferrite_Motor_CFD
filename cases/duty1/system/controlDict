FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamMultiRun;
regionSolvers
{
    bearings   solid;
    housing    solid;
    inair      solid;
    magnets    solid;
    rotor      solid;
    shaft      solid;
    stator     solid;
    winding    solid;
}
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         480;
deltaT          3;
adjustTimeStep  no;          // implicit conduction: fixed step, stable at any diffusion number
writeControl    adjustableRunTime;
writeInterval   60;
purgeWrite      0;
writeFormat     binary;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;
functions
{
    T_bearings
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          bearings;
        select          all;
        fields          (T);
        operation       max;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    T_housing
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          housing;
        select          all;
        fields          (T);
        operation       max;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    T_inair
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          inair;
        select          all;
        fields          (T);
