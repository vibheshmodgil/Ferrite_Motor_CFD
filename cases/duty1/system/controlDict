        log             false;
    }
    Tavg_winding
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          winding;
        select          all;
        fields          (T);
        operation       volAverage;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    Tavg_magnets
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          magnets;
        select          all;
        fields          (T);
        operation       volAverage;
