        fields          (T);
        operation       max;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    T_rotor
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          rotor;
        select          all;
        fields          (T);
        operation       max;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    T_shaft
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          shaft;
        select          all;
