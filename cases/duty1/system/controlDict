        log             false;
    }
    Qout_housing
    {
        type            wallHeatFlux;     // heat through the outer skin every step, for the global energy balance
        libs            ("libfieldFunctionObjects.so");
        region          housing;
        patches         (defaultFaces);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    Qout_shaft
