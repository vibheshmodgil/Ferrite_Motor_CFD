FoamFile { format ascii; class dictionary; object x; }
solvers
{
    p_rgh { solver GAMG; smoother DICGaussSeidel; tolerance 1e-7; relTol 0.05; }
    "(U|h|k|omega)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.1; }
    "rho.*" { solver diagonal; }
}
PIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 1;
    pRefCell 0;
    pRefValue 0;
    residualControl { p_rgh 1e-4; U 1e-4; h 1e-5; "(k|omega)" 1e-4; }
}
relaxationFactors { fields { rho 1; p_rgh 0.3; } equations { U 0.5; h 0.5; k 0.5; omega 0.5; } }
