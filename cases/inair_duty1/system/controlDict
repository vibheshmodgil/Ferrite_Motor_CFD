FoamFile { format ascii; class dictionary; object x; }
application foamRun; solver fluid;
startFrom latestTime; startTime 0; stopAt endTime; endTime 2500; deltaT 1;
writeControl timeStep; writeInterval 500; purgeWrite 1; writeFormat ascii; timeFormat general;
runTimeModifiable yes;
functions
{
    heat { type wallHeatFlux; libs ("libfieldFunctionObjects.so"); writeControl writeTime; }
    airT { type volFieldValue; libs ("libfieldFunctionObjects.so"); select all; fields (T); operation volAverage;
           writeFields false; writeControl writeTime; }
}
