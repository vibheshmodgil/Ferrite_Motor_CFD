FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/stator";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 4;

boundaryField
{
    stator_to_resin
    {
        type            calculated;
        value           uniform 0;
    }
    stator_to_housing
    {
        type            calculated;
        value           uniform 0;
    }
    stator_to_rotor
    {
        type            calculated;
        value           uniform 0;
    }
    stator_to_inair
    {
        type            calculated;
        value           uniform 0;
    }
    stator_to_bobbin
    {
        type            calculated;
        value           uniform 0;
    }
}


