FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/bearings";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 2;

boundaryField
{
    defaultFaces
    {
        type            zeroGradient;
    }
    bearings_to_shaft
    {
        type            calculated;
        value           uniform 0;
    }
    bearings_to_inair
    {
        type            calculated;
        value           uniform 0;
    }
    bearings_to_housing
    {
        type            calculated;
        value           uniform 0;
    }
}


