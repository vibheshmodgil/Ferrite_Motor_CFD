FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamMultiRun;
regionSolvers
{
    bearings   solid;
    bobbin     solid;
    copper     solid;
    housing    solid;
    inair      solid;
    magnets    solid;
    resin      solid;
    rotor      solid;
    shaft      solid;
    stator     solid;
}
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         477;
deltaT          3;
adjustTimeStep  no;          // implicit conduction: fixed step, stable at any diffusion number
writeControl    adjustableRunTime;
writeInterval   60;
purgeWrite      0;
writeFormat     binary;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;
functions
{
    T_bearings
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          bearings;
        select          all;
        fields          (T);
        operation       max;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    T_bobbin
