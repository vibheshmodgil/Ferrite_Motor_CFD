FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamMultiRun;
libs            ("libcoupledTemperatureNC.so");
regionSolvers
{
    winding    solid;
    bearings   solid;
    endcaps    solid;
    housing    solid;
    inair      solid;
    magnets    solid;
    rotor      solid;
    shaft      solid;
    stator     solid;
    wedge      solid;
}   // winding (fastest-rising T) solved first: smaller coupling lag
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime 300;
deltaT 1;
adjustTimeStep  no;
writeControl    adjustableRunTime;
writeInterval 30;
purgeWrite      0;
writeFormat     binary;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;
